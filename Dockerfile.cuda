ARG CUDA_VERSION=12.9.1
ARG CUDA_COMPAT_VERSION=12-9
ARG CUDA_COMPUTE_CAPS=80
ARG UBUNTU_VERSION=24.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS chef

ARG RUST_VERSION=1.98.1

ENV PATH="/root/.cargo/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal
RUN cargo install cargo-chef --version 0.1.78 --locked

WORKDIR /app

FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json

ARG CUDA_COMPUTE_CAPS

RUN set -eux; \
    if ! printf '%s\n' "${CUDA_COMPUTE_CAPS}" \
        | grep -Eq '^(75|80|89|90|100|120)(;(75|80|89|90|100|120))*$'; then \
        echo "unsupported CUDA compute capabilities: ${CUDA_COMPUTE_CAPS}" >&2; \
        exit 1; \
    fi; \
    compute_caps="$(printf '%s' "${CUDA_COMPUTE_CAPS}" | tr ';' ' ')"; \
    for compute_cap in ${compute_caps}; do \
        CUDA_COMPUTE_CAP="${compute_cap}" \
        CARGO_TARGET_DIR="target/${compute_cap}" \
        cargo chef cook \
            --release \
            --no-default-features \
            --features cuda \
            --recipe-path recipe.json; \
    done

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN set -eux; \
    compute_caps="$(printf '%s' "${CUDA_COMPUTE_CAPS}" | tr ';' ' ')"; \
    set -- ${compute_caps}; \
    install -d /app/bin; \
    for compute_cap do \
        CUDA_COMPUTE_CAP="${compute_cap}" \
        CARGO_TARGET_DIR="target/${compute_cap}" \
        cargo build \
            --release \
            --locked \
            --no-default-features \
            --features cuda \
            --bin sys1; \
        if [ "$#" -eq 1 ]; then \
            install "target/${compute_cap}/release/sys1" /app/bin/sys1; \
        else \
            install "target/${compute_cap}/release/sys1" "/app/bin/sys1-${compute_cap}"; \
        fi; \
    done

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime

ARG CUDA_COMPAT_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates "cuda-compat-${CUDA_COMPAT_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 10001 --user-group --create-home sys1 \
    && install -d -o sys1 -g sys1 /home/sys1/.cache/huggingface /home/sys1/.cache/nvidia

ENV HOME=/home/sys1 \
    HF_HOME=/home/sys1/.cache/huggingface \
    CUDA_CACHE_PATH=/home/sys1/.cache/nvidia

COPY --chmod=755 cuda-entrypoint.sh /usr/local/bin/cuda-entrypoint.sh
COPY --from=builder /app/bin/ /usr/local/bin/

USER sys1

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/cuda-entrypoint.sh"]
