ARG CUDA_VERSION=12.9.1
ARG CUDA_COMPAT_VERSION=12-9
ARG CUDA_COMPUTE_CAPS=80
ARG UBUNTU_VERSION=24.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS chef

ARG RUST_VERSION=1.98.1
ARG SCCACHE_VERSION=0.18.0
ARG SCCACHE_SHA256_AMD64=45f1447fbe231e3037bde351ef70677dd212216c8d62ae7ca409fecc4d6acc89
ARG SCCACHE_SHA256_ARM64=2b3284d5da3b46a47dc4229e75bb7b88ac4aa99c8d754fb7d2f84997e5a4354a
ARG TARGETARCH

ENV PATH="/root/.cargo/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal
RUN case "${TARGETARCH}" in \
        amd64) sccache_target=x86_64-unknown-linux-musl; sccache_sha256="${SCCACHE_SHA256_AMD64}" ;; \
        arm64) sccache_target=aarch64-unknown-linux-musl; sccache_sha256="${SCCACHE_SHA256_ARM64}" ;; \
        *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-${sccache_target}.tar.gz" \
        -o /tmp/sccache.tar.gz \
    && echo "${sccache_sha256}  /tmp/sccache.tar.gz" | sha256sum --check \
    && tar -xzf /tmp/sccache.tar.gz -C /tmp \
    && install "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_target}/sccache" /usr/local/bin/sccache \
    && rm -rf /tmp/sccache.tar.gz "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_target}"
RUN cargo install cargo-chef --version 0.1.78 --locked

COPY --chmod=755 sccache-nvcc.sh /usr/local/bin/nvcc

ENV RUSTC_WRAPPER=/usr/local/bin/sccache

WORKDIR /app

FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json

ARG CUDA_COMPUTE_CAPS
ARG SCCACHE_GHA_ENABLED=off

RUN --mount=type=cache,id=sys1-sccache,target=/root/.cache/sccache,sharing=locked \
    --mount=type=secret,id=ACTIONS_RESULTS_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN \
    set -eu; \
    if [ "${SCCACHE_GHA_ENABLED}" = on ]; then \
        test -s /run/secrets/ACTIONS_RESULTS_URL; \
        test -s /run/secrets/ACTIONS_RUNTIME_TOKEN; \
        export SCCACHE_GHA_ENABLED=on; \
        export SCCACHE_GHA_VERSION=sys1-v1; \
        export ACTIONS_RESULTS_URL="$(cat /run/secrets/ACTIONS_RESULTS_URL)"; \
        export ACTIONS_RUNTIME_TOKEN="$(cat /run/secrets/ACTIONS_RUNTIME_TOKEN)"; \
    else \
        unset SCCACHE_GHA_ENABLED; \
    fi; \
    if ! printf '%s\n' "${CUDA_COMPUTE_CAPS}" \
        | grep -Eq '^(75|80|86|89|90|100|120)(;(75|80|86|89|90|100|120))*$'; then \
        echo "unsupported CUDA compute capabilities: ${CUDA_COMPUTE_CAPS}" >&2; \
        exit 1; \
    fi; \
    compute_caps="$(printf '%s' "${CUDA_COMPUTE_CAPS}" | tr ';' ' ')"; \
    for compute_cap in ${compute_caps}; do \
        CUDA_COMPUTE_CAP="${compute_cap}" \
        CARGO_TARGET_DIR="target/${compute_cap}" \
        cargo chef cook \
            --release \
            --no-default-features \
            --features cuda \
            --recipe-path recipe.json; \
    done; \
    sccache --show-stats

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN --mount=type=cache,id=sys1-sccache,target=/root/.cache/sccache,sharing=locked \
    --mount=type=secret,id=ACTIONS_RESULTS_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN \
    set -eu; \
    if [ "${SCCACHE_GHA_ENABLED}" = on ]; then \
        test -s /run/secrets/ACTIONS_RESULTS_URL; \
        test -s /run/secrets/ACTIONS_RUNTIME_TOKEN; \
        export SCCACHE_GHA_ENABLED=on; \
        export SCCACHE_GHA_VERSION=sys1-v1; \
        export ACTIONS_RESULTS_URL="$(cat /run/secrets/ACTIONS_RESULTS_URL)"; \
        export ACTIONS_RUNTIME_TOKEN="$(cat /run/secrets/ACTIONS_RUNTIME_TOKEN)"; \
    else \
        unset SCCACHE_GHA_ENABLED; \
    fi; \
    compute_caps="$(printf '%s' "${CUDA_COMPUTE_CAPS}" | tr ';' ' ')"; \
    set -- ${compute_caps}; \
    install -d /app/bin; \
    for compute_cap do \
        CUDA_COMPUTE_CAP="${compute_cap}" \
        CARGO_TARGET_DIR="target/${compute_cap}" \
        cargo build \
            --release \
            --locked \
            --no-default-features \
            --features cuda \
            --bin sys1; \
        if [ "$#" -eq 1 ]; then \
            install "target/${compute_cap}/release/sys1" /app/bin/sys1; \
        else \
            install "target/${compute_cap}/release/sys1" "/app/bin/sys1-${compute_cap}"; \
        fi; \
    done; \
    sccache --show-stats

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime

ARG CUDA_COMPAT_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates "cuda-compat-${CUDA_COMPAT_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 10001 --user-group --create-home sys1 \
    && install -d -o sys1 -g sys1 /home/sys1/.cache/huggingface /home/sys1/.cache/nvidia

ENV HOME=/home/sys1 \
    HF_HOME=/home/sys1/.cache/huggingface \
    CUDA_CACHE_PATH=/home/sys1/.cache/nvidia

COPY --chmod=755 cuda-entrypoint.sh /usr/local/bin/cuda-entrypoint.sh
COPY --from=builder /app/bin/ /usr/local/bin/

USER sys1

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/cuda-entrypoint.sh"]
