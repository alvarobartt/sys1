ARG CUDA_VERSION=12.9.1
ARG CUDA_COMPAT_VERSION=12-9
ARG UBUNTU_VERSION=24.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS chef

ARG RUST_VERSION=1.98.1

ENV PATH="/root/.cargo/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal
RUN cargo install cargo-chef --version 0.1.78 --locked

WORKDIR /app

FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder-base

COPY --from=planner /app/recipe.json recipe.json

FROM builder-base AS builder-75

RUN CUDA_COMPUTE_CAP=75 cargo chef cook --release --no-default-features --features cuda --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN CUDA_COMPUTE_CAP=75 cargo build --release --locked --no-default-features --features cuda --bin sys1

FROM builder-base AS builder-80

RUN CUDA_COMPUTE_CAP=80 cargo chef cook --release --no-default-features --features cuda --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN CUDA_COMPUTE_CAP=80 cargo build --release --locked --no-default-features --features cuda --bin sys1

FROM builder-base AS builder-90

RUN CUDA_COMPUTE_CAP=90 cargo chef cook --release --no-default-features --features cuda --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN CUDA_COMPUTE_CAP=90 cargo build --release --locked --no-default-features --features cuda --bin sys1

FROM builder-base AS builder-100

RUN CUDA_COMPUTE_CAP=100 cargo chef cook --release --no-default-features --features cuda --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN CUDA_COMPUTE_CAP=100 cargo build --release --locked --no-default-features --features cuda --bin sys1

FROM builder-base AS builder-120

RUN CUDA_COMPUTE_CAP=120 cargo chef cook --release --no-default-features --features cuda --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY src ./src

RUN CUDA_COMPUTE_CAP=120 cargo build --release --locked --no-default-features --features cuda --bin sys1

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION} AS runtime

ARG CUDA_COMPAT_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates "cuda-compat-${CUDA_COMPAT_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 10001 --user-group --create-home sys1 \
    && install -d -o sys1 -g sys1 /home/sys1/.cache/huggingface /home/sys1/.cache/nvidia

ENV HOME=/home/sys1 \
    HF_HOME=/home/sys1/.cache/huggingface \
    CUDA_CACHE_PATH=/home/sys1/.cache/nvidia

COPY --from=builder-75 /app/target/release/sys1 /usr/local/bin/sys1-75
COPY --from=builder-80 /app/target/release/sys1 /usr/local/bin/sys1-80
COPY --from=builder-90 /app/target/release/sys1 /usr/local/bin/sys1-90
COPY --from=builder-100 /app/target/release/sys1 /usr/local/bin/sys1-100
COPY --from=builder-120 /app/target/release/sys1 /usr/local/bin/sys1-120
COPY --chmod=755 cuda-entrypoint.sh /usr/local/bin/cuda-entrypoint.sh

USER sys1

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/cuda-entrypoint.sh"]
CMD ["--host", "0.0.0.0"]
