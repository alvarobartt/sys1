FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS chef
ARG RUST_VERSION=1.98.1
ARG CUDA_COMPUTE_CAP=80
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CUDA_COMPUTE_CAP="${CUDA_COMPUTE_CAP}"
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl pkg-config && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal
RUN cargo install cargo-chef --version 0.1.78 --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --no-default-features --features cuda --recipe-path recipe.json
COPY . .
RUN cargo build --release --locked --no-default-features --features cuda --bin sys1

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home sys1
ENV HF_HOME=/home/sys1/.cache/huggingface
COPY --from=builder /app/target/release/sys1 /usr/local/bin/sys1
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
USER sys1
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["--host", "0.0.0.0"]
